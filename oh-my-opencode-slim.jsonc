{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
  "preset": "balanced",
  "presets": {
    "balanced": {
      "orchestrator": {
        "model": "zai-coding-plan/glm-5.3-flash",
        "variant": "high",
        "skills": ["*"],
        "mcps": ["*"]
      },
      "oracle": {
        "model": "zai-coding-plan/glm-5.3",
        "variant": "medium",
        "skills": [
          "simplify"
        ],
        "mcps": []
      },
      "librarian": {
        "model": "zai-coding-plan/glm-5.3-flash",
        "variant": "low",
        "skills": [],
        "mcps": [
          "websearch",
          "context7",
          "gh_grep"
        ]
      },
      "explorer": {
        "model": "zai-coding-plan/glm-5.3-flash",
        "variant": "low",
        "skills": [],
        "mcps": ["telegram"]
      },
      "fixer": {
        "model": "zai-coding-plan/glm-5.3-flash",
        "variant": "low",
        "skills": [],
        "mcps": []
      },
      "designer": {
        "model": "zai-coding-plan/glm-5.3-flash",
        "variant": "high",
        "skills": [],
        "mcps": []
      },
      "observer": {
        "model": "zai-coding-plan/glm-5.3-flash",
        "variant": "low",
        "skills": [],
        "mcps": []
      },
      "council": {
        "model": "zai-coding-plan/glm-5.3",
        "variant": "medium",
        "skills": [
          "simplify"
        ],
        "mcps": []
      }
    }
  },
  "disabled_agents": [
    "observer",
    "council"
  ],
  "backgroundJobs": {
    "maxSessionsPerAgent": 2,
    "readContextMinLines": 10,
    "readContextMaxFiles": 6
  },
  "fallback": {
    "enabled": true,
    "maxRetries": 1
  },
  "multiplexer": {
    "type": "auto",
    "layout": "main-vertical",
    "main_pane_size": 65
  },
  "autoUpdate": true
}
