{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",

  // Основной профиль: economy | balanced | deep
  "preset": "balanced",

  "presets": {
    // ============================================================
    // ECONOMY
    // Минимальный расход: массовая работа на Luna.
    // Terra координирует и решает задачи, требующие больше качества.
    // Sol используется только для редкого архитектурного анализа.
    // ============================================================
    "economy": {
      "orchestrator": {
        "model": "openai/gpt-5.6-terra",
        "variant": "low",
        "skills": ["*"],
        "mcps": ["contextstream", "codebase-memory-mcp"]
      },

      "oracle": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium",
        "skills": ["simplify"],
        "mcps": []
      },

      "librarian": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low",
        "skills": [],
        "mcps": ["websearch", "context7", "gh_grep"]
      },

      "explorer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low",
        "skills": [],
        "mcps": []
      },

      "fixer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low",
        "skills": [],
        "mcps": []
      },

      "designer": {
        "model": "openai/gpt-5.6-terra",
        "variant": "medium",
        "skills": [],
        "mcps": []
      },

      "observer": {
        // Priority-route оставлен для интерактивного анализа изображений.
        "model": "openai/gpt-5.6-luna",
        "variant": "low",
        "skills": [],
        "mcps": []
      },

      "council": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium",
        "skills": ["simplify"],
        "mcps": []
      }
    },

    // ============================================================
    // BALANCED
    // Основной профиль для ежедневной разработки.
    // Luna выполняет массовую и хорошо ограниченную работу.
    // Terra отвечает за координацию, реализацию и дизайн.
    // Sol используется для Oracle.
    // ============================================================
    "balanced": {
      "orchestrator": {
        // Priority-route оправдан здесь: пользователь ждёт координации.
        "model": "openai/gpt-5.6-terra",
        "variant": "medium",
        "skills": ["*"],
        "mcps": ["contextstream", "codebase-memory-mcp"]
      },

      "oracle": {
        "model": "openai/gpt-5.6-sol",
        "variant": "high",
        "skills": ["simplify"],
        "mcps": []
      },

      "librarian": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low",
        "skills": [],
        "mcps": ["websearch", "context7", "gh_grep"]
      },

      "explorer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low",
        "skills": [],
        "mcps": []
      },

      "fixer": {
        "model": "openai/gpt-5.6-terra",
        "variant": "medium",
        "skills": [],
        "mcps": []
      },

      "designer": {
        "model": "openai/gpt-5.6-terra",
        "variant": "medium",
        "skills": [],
        "mcps": []
      },

      "observer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low",
        "skills": [],
        "mcps": []
      },

      "council": {
        "model": "openai/gpt-5.6-sol",
        "variant": "high",
        "skills": ["simplify"],
        "mcps": []
      }
    },

    // ============================================================
    // DEEP
    // Для /deepwork, архитектурных миграций и тяжёлой отладки.
    // ============================================================
    "deep": {
      "orchestrator": {
        "model": "openai/gpt-5.6-terra",
        "variant": "high",
        "skills": ["*"],
        "mcps": ["contextstream", "codebase-memory-mcp"]
      },

      "oracle": {
        "model": "openai/gpt-5.6-sol",
        "variant": "high",
        "skills": ["simplify"],
        "mcps": []
      },

      "librarian": {
        "model": "openai/gpt-5.6-luna",
        "variant": "medium",
        "skills": [],
        "mcps": ["websearch", "context7", "gh_grep"]
      },

      "explorer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "medium",
        "skills": [],
        "mcps": []
      },

      "fixer": {
        "model": "openai/gpt-5.6-terra",
        "variant": "high",
        "skills": [],
        "mcps": []
      },

      "designer": {
        "model": "openai/gpt-5.6-terra",
        "variant": "high",
        "skills": [],
        "mcps": []
      },

      "observer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "medium",
        "skills": [],
        "mcps": []
      },

      "council": {
        // Самый дорогой priority-route доступен только отключённому Council.
        "model": "openai/gpt-5.6-sol",
        "variant": "high",
        "skills": ["simplify"],
        "mcps": []
      }
    }
  },

  // Observer отключён, если не требуется анализ изображений.
  // Council отключён для защиты лимита и требует отдельного council.presets.
  "disabled_agents": [
    "observer",
    "council"
  ],

  // Ограничиваем накопление дочерних сессий и лишний параллелизм.
  "backgroundJobs": {
    "maxSessionsPerAgent": 2,
    "readContextMinLines": 10,
    "readContextMaxFiles": 6
  },

  // Повторяем только временные ошибки.
  "fallback": {
    "enabled": true,
    "timeoutMs": 20000,
    "retryDelayMs": 750,
    "maxRetries": 1,
    "runtimeOverride": true,
    "retry_on_empty": true
  },

  // Внутри tmux/zellij субагенты будут открываться в отдельных панелях.
  "multiplexer": {
    "type": "auto",
    "layout": "main-vertical",
    "main_pane_size": 65
  },

  "autoUpdate": true
}
