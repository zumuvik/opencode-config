{
  "$schema": "https://opencode.ai/config.json",

  "plugin": [
    "oh-my-opencode-slim",
    "opencode-github-release",
    "opencode-mem"
  ],

  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
 "mcp": {
    "codebase-memory-mcp": {
      "type": "local",
      "command": ["/home/zumuvik/.local/bin/codebase-memory-mcp"],
      "enabled": true
    },
      "tangled": {
    "type": "local",
    "command": [
  "uvx",
  "--from",
  "git+https://github.com/zzstoatzz/tangled-mcp",
  "tangled-mcp"
	],
    "enabled": true,
    "environment": {
      "TANGLED_HANDLE": "zumuvik.tngl.sh",
      "TANGLED_PASSWORD": "{file:~/.config/opencode/password/tangled-app-password}"
    }
  },

   "telegram": {
  "type": "local",
  "command": [
    "uvx",
    "--from",
    "git+https://github.com/chigwell/telegram-mcp.git@v3.2.30",
    "telegram-mcp"
  ],
  "enabled": true,
  "environment": {
    "TELEGRAM_API_ID": "{file:~/.config/opencode/password/telegram-api-id}",
    "TELEGRAM_API_HASH": "{file:~/.config/opencode/password/telegram-api-hash}",
    "TELEGRAM_SESSION_STRING": "{file:~/.config/opencode/password/telegram-session-string}"
   	  }
 	 },
    "youtube": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@anaisbetts/mcp-youtube"
      ],
      "enabled": true
    }
 },
"lsp": true,
  "shell": "/run/current-system/sw/bin/zsh"
}
